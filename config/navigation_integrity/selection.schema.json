{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Navigation integrity endpoint and middle reuse selection V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm_type", "algorithm_id", "version", "parameters"],
  "properties": {
    "algorithm_type": {"const": "site_planner"},
    "algorithm_id": {"const": "navigation_integrity_endpoint_middle_reuse_v1"},
    "version": {"const": "1.0"},
    "parameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "middle_segment_indices": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    }
  }
}
